{
  "ignorePatterns": ["node_modules", "dist", ".turbo"],
  "extends": [
    "../oxlint-config/index.jsonc"
    // "@croco-calc/oxlint-config"
  ],
  "rules": {
    // ME-166: the platform's unseeded generator MUST NOT appear anywhere in
    // packages/math-engine. All randomness comes from the seeded mulberry32 PRNG
    // (ME-002, ME-167). Belt and braces: __tests__/purity.spec.ts asserts the
    // same thing as a raw token over the whole package (which is what DoD-10
    // greps for), so the guarantee survives a linter swap. The banned identifier
    // pair is only ever written as the two separate fields below.
    "no-restricted-properties": [
      "error",
      {
        "object": "Math",
        "property": "random",
        "message": "ME-166: use the seeded mulberry32 PRNG (src/prng.ts), never the platform's unseeded generator."
      }
    ]
  }
}
