# croco calc — build-time configuration (TEMPLATE). INF-087.
#
# No real credential may ever appear in this file. It is committed; every value
# below is an empty placeholder and must stay that way.
#
# WHERE TO COPY IT
#   `pnpm build-fe` / `pnpm dev-fe` run vite with the working directory set to
#   `frontend/`, and vite.config.ts calls `loadEnv(mode, process.cwd(), "")`.
#   So the file vite actually reads is `frontend/.env.local`:
#
#       cp .env.example frontend/.env.local
#
#   Both `.env*` names are gitignored, so the copy can never be committed.
#
# HOW FIREBASE CONFIG IS LOADED
#   - Local dev does NOT read these variables. It imports a TypeScript module,
#     frontend/src/ts/constants/firebase-config.ts (gitignored); create it from
#     firebase-config-example.ts.
#   - A PRODUCTION build DOES read them. frontend/vite-plugins/firebase-config.ts
#     generates frontend/src/ts/constants/firebase-config-live.ts from the six
#     values below and fails the build if any is missing (INF-090, INF-099,
#     INF-100, INF-101). The generated file is never committed.
#   In CI these arrive as the GitHub secrets of the same names (INF-086).
#
# The six Firebase WEB values are not secret — they ship inside the bundle — but
# they are kept out of the repo until we choose to land them.

FIREBASE_APIKEY=
FIREBASE_AUTHDOMAIN=
FIREBASE_PROJECTID=
FIREBASE_STORAGEBUCKET=
FIREBASE_MESSAGINGSENDERID=
FIREBASE_APPID=

# Origin of the API. A production build REFUSES to run when this is unset, empty
# or points at monkeytype.com (INF-013). In production it is the Terraform
# output api_base_url, published as the repository variable BACKEND_URL by
# infra.yml (INF-086a). Locally: http://localhost:5005
BACKEND_URL=

# reCAPTCHA v2 ("I'm not a robot") site key. A production build refuses to run
# without it (INF-105). Google's public test key must not be used here
# (INF-107). Dev builds ignore this and hardcode the test key.
RECAPTCHA_SITE_KEY=

### === Optional, development only ===

# Prefill the login form. Never set in CI or production; env-config.ts drops
# both from the production bundle unconditionally.
QUICK_LOGIN_EMAIL=
QUICK_LOGIN_PASSWORD=

# Set to "false" to stop `pnpm dev-fe` opening a browser tab.
SERVER_OPEN=

### === Backend ===
#
# The backend does not read this file — see backend/example.env, which it copies
# to backend/.env. Two values are worth repeating because they are the ones that
# differ between local and production:
#
#   DB_URI                          local: mongodb://localhost:27017
#                                   prod : the Key Vault secret `mongodb-uri`
#   FIREBASE_SERVICE_ACCOUNT_JSON   local: unset, falls back to
#                                          backend/src/credentials/serviceAccountKey.json
#                                   prod : the Key Vault secret
#                                          `firebase-service-account` (INF-097,
#                                          INF-098). There is no BYPASS_FIREBASE
#                                          escape hatch; it was removed because
#                                          it disables authentication outright.
