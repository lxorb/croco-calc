# Copy this file to `.env` before starting the containers.
# INF-087: placeholders only — no real credential may ever appear here.

### === Required Config ===

# URL of the frontend (accessible by browser)
CROCOCALC_FRONTENDURL=http://myserver:8080

# URL of the backend (accessible by browser)
CROCOCALC_BACKENDURL=http://myserver:5005

### === Google reCAPTCHA ===

# Register a v2 ("I'm not a robot") site at https://www.google.com/recaptcha/admin.
# INF-107: monkeytype's public test keys MUST NOT be carried into production, so
# they are not listed here either.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

### === Firebase Auth ===

# Uncomment if using user accounts. These six values are what the frontend build
# turns into firebase-config-live.ts (INF-090, INF-099).
# FIREBASE_APIKEY=AIzaSy********
# FIREBASE_AUTHDOMAIN=your-app.firebaseapp.com
# FIREBASE_PROJECTID=your-app
# FIREBASE_STORAGEBUCKET=your-app.appspot.com
# FIREBASE_MESSAGINGSENDERID=1234567890
# FIREBASE_APPID=1:1234567890:web:abcdef123456

### === Optional: Custom Ports ===

# BACKEND_PORT=5005
# MONGO_PORT=27017

# Email (EMAIL_HOST / EMAIL_USER / EMAIL_PASS / EMAIL_PORT / EMAIL_FROM) is
# unused: Firebase Auth sends verification and password-reset mail itself
# (INF-053). The cache and queue layer is unused too (INF-063).
