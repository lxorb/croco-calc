#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# croco calc commit convention (INF-134, INF-135):
#   - single line, no body, no trailers
#   - all lowercase
#   - at most 5 words
#   - no Co-Authored-By trailer, no mention of Claude / AI authorship

msg_file="$1"

# strip comment lines, then trailing blank lines
body=$(sed -e '/^#/d' "$msg_file" | sed -e :a -e '/^\n*$/{$d;N;};/\n$/ba')

subject=$(printf '%s\n' "$body" | sed -n '1p')
extra=$(printf '%s\n' "$body" | sed -n '2,$p' | tr -d '[:space:]')

fail() {
  echo "commit rejected: $1" >&2
  echo "" >&2
  echo "  message: $subject" >&2
  echo "" >&2
  echo "  croco calc commits are a single lowercase line of at most 5 words," >&2
  echo "  with no body and no trailers. no AI attribution, ever." >&2
  exit 1
}

# merge commits are generated by git and are exempt
case "$subject" in
"Merge "* | "merge "*) exit 0 ;;
esac

if [ -z "$subject" ]; then
  fail "empty commit message"
fi

if [ -n "$extra" ]; then
  fail "message has a body; use a single line"
fi

if printf '%s' "$subject" | grep -q '[A-Z]'; then
  fail "message must be all lowercase"
fi

words=$(printf '%s' "$subject" | wc -w | tr -d ' ')
if [ "$words" -gt 5 ]; then
  fail "message has $words words; the limit is 5"
fi

if printf '%s' "$body" | grep -qi 'co-authored-by'; then
  fail "message contains a Co-Authored-By trailer"
fi

if printf '%s' "$body" | grep -qi 'claude\|generated with\|ai-authored\|ai authored'; then
  fail "message mentions AI authorship"
fi

exit 0
