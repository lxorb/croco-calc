{
  // `infra/` is not a pnpm workspace package, so neither `mongodb` nor
  // `@types/node` resolve from here on their own. Without this file
  // `oxlint --type-aware` sees every import as an error type and reports
  // dozens of phantom no-unsafe-* violations in scripts/db-probe.ts.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "paths": {
      "mongodb": ["../backend/node_modules/mongodb/mongodb.d.ts"]
    }
  },
  "include": ["scripts/**/*.ts"]
}
